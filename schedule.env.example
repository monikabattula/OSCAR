# Copy to `schedule.env` in the project root and edit. Used by `scripts/serp_collect_scheduled.sh`.
# Quote values that contain spaces.

# Required: search query (examples: health policy OSINT or university recruitment)
SERP_QUERY='site:.gov maryland disability'

# duckduckgo | google | reddit  (google: GOOGLE_* in `.env`; reddit: REDDIT_* in `.env`)
SERP_ENGINE=duckduckgo

# 24h | week | month | year | custom
SERP_PERIOD=week

# If SERP_PERIOD=custom, set both:
# SERP_START_DATE=2025-01-01
# SERP_END_DATE=2025-03-01

SERP_MAX_RESULTS=50

# Output CSV (relative to project root or absolute). Uses --append so each run adds rows.
SERP_OUTPUT=out/scheduled_serp.csv
