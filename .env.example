# Required only for --engine google
GOOGLE_API_KEY=
# Programmable Search Engine ID (cx)
GOOGLE_CSE_ID=

# Required for --engine reddit (create app at https://www.reddit.com/prefs/apps )
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Descriptive User-Agent (Reddit API rule), e.g. serp-prototype/0.1 by u/YourUsername
REDDIT_USER_AGENT=

# Optional: Google AI Studio (Gemini) for Insights tab — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional alias:
# GEMINI_API_KEY=
# Optional model id (default in UI: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
